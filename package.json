    "react-router-dom": "7.6.0",
    "tsx": "4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/express": "5.0.3",
    "@types/node": "24.0.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.5.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
