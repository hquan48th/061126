FROM php:8.3-apache@sha256:a800bbd2c0aa322702259ed475556b2cbc311076a8d3c4bba9bfe96838745472
RUN groupadd -g 1000 agent && useradd -u 1000 -g 1000 agent
RUN --mount=type=secret,id=proxy_ca,target=/usr/local/share/ca-certificates/cloud.crt,required=true \
    update-ca-certificates && apt-get update && apt-get install -y --no-install-recommends libonig-dev libpng-dev libjpeg62-turbo-dev libwebp-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp && docker-php-ext-install pdo_mysql mbstring gd && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*
RUN update-ca-certificates --fresh
RUN printf '<Directory /var/www/html>\nAllowOverride All\nRequire all granted\n</Directory>\n' > /etc/apache2/conf-available/fillico.conf && a2enconf fillico
RUN sed -i s@/var/www/html@/var/www/public_html@g /etc/apache2/sites-available/000-default.conf /etc/apache2/conf-available/fillico.conf
